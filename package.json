{
  "name": "lamina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Living 3D scientific plates: page-turnable, interactive WebGPU books built from a Claude Code skill.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/i18n-core-test.mjs && node scripts/hyphen-es-test.mjs",
    "test:i18n": "node scripts/i18n-core-test.mjs",
    "test:hyphen-es": "node scripts/hyphen-es-test.mjs",
    "validate": "node scripts/validate-books.mjs",
    "validate:all": "node scripts/validate-books.mjs --lang all",
    "i18n": "node scripts/i18n-strings.mjs --lang es --missing",
    "audit": "node scripts/audit.mjs",
    "shot": "node scripts/shot.mjs",
    "capture": "node scripts/capture.mjs",
    "export-svg": "node scripts/export-svg.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  }
}
